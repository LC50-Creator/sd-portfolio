# ----- Part 2: different data types -----
age = 30            # int
price = 19.99       # float
name = "Lee"        # string
is_student = True   # boolean
 
print(type(age))
print(type(price))
print(type(name))
print(type(is_student))
 
# mixing an int and a float gives a float
print(age + price)
 
# you can't add a string and a number, so convert it first
print("Age: " + str(age))
 
 
